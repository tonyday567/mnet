cabal-version:      3.0
name:               mnet
version:            0.1.0.0
synopsis:           Modular neural network as a circuits-ecosystem client
description:
  A small neural-network library rebuilt on the circuits ecosystem:
  circuits-mat for linear algebra, circuits-ad for reverse-mode gradients,
  circuits-learn for optimiser processes, and Circuit.Poly for the
  coalgebra view of training.

license:            BSD-3-Clause
author:             tonyday567
maintainer:         tonyday567@gmail.com
category:           Machine Learning
build-type:         Simple

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wredundant-constraints

library
  import:           warnings
  exposed-modules:
    Net
    NetCoalgebra
  hs-source-dirs:   src
  default-language: GHC2024
  build-depends:
    base >=4.18 && <5,
    circuits,
    circuits-ad,
    circuits-learn,
    circuits-mat,
    harpie >=0.3 && <0.4,
    numhask >=0.14 && <0.15,
    these,
    vector >=0.12 && <0.14,
  default-extensions:
    GADTs
    DataKinds
    RankNTypes
    ScopedTypeVariables
    TypeFamilies
    TypeOperators
    UnicodeSyntax

test-suite oracle
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Oracle.hs
  hs-source-dirs:   test
  default-language: GHC2024
  build-depends:
    base >=4.18 && <5,
    circuits,
    circuits-ad,
    circuits-mat,
    harpie >=0.3 && <0.4,
    mnet,
    numhask >=0.14 && <0.15,
    these,
    vector >=0.12 && <0.14,
