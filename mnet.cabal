cabal-version: 3.0
name: mnet
version: 0.1.0.0
synopsis: Modular neural network as a circuits-ecosystem client
description:
  A small neural-network library rebuilt on the circuits ecosystem:
  circuits-mat for linear algebra, circuits-diff for reverse-mode gradients,
  circuits-learn for optimiser processes, and Circuit.Poly for the
  coalgebra view of training.

license: BSD-3-Clause
author: tonyday567
maintainer: tonyday567@gmail.com
category: Machine Learning
build-type: Simple

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wredundant-constraints

library
  import: warnings
  exposed-modules:
    Net
    NetCoalgebra

  hs-source-dirs: src
  default-language: GHC2024
  build-depends:
    base >=4.20 && <5,
    circuits,
    circuits-diff,
    circuits-learn,
    circuits-mat,
    harpie >=0.3 && <0.4,
    numhask >=0.14 && <0.15,
    these,
    vector >=0.12 && <0.14,

  default-extensions:
    DataKinds
    GADTs
    RankNTypes
    ScopedTypeVariables
    TypeFamilies
    TypeOperators
    UnicodeSyntax

executable mnet-axioma
  import: warnings
  hs-source-dirs: app
  main-is: axioma.hs
  default-language: GHC2024
  build-depends:
    base >=4.20 && <5,
    circuits-mat,
    harpie >=0.3 && <0.4,
    mnet,
