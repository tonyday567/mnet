cabal-version:      3.0
name:               mnet
version:            0.1.0.0
synopsis:           Modular neural network with bidirectional Store morphisms
description:        A neural network library based on Para, LensS, and Store for composable forward and backward passes.
license:            BSD-3-Clause
author:             tonyday567
maintainer:         tonyday567@gmail.com
category:           Machine Learning
build-type:         Simple

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wredundant-constraints

library
  import:           warnings
  exposed-modules:
    Net
    Para
    LensS
    NetCoalgebra
    NetCoalgebra.Poly
  hs-source-dirs:   src
  default-language: GHC2024
  build-depends:
    base >=4.18 && <5,
    circuits,
    string-diagrams,
    profunctors >=5.6.3 && <6,
    harpie >=0.1 && <1,
  default-extensions:
    UnicodeSyntax

test-suite oracle
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Oracle.hs
  hs-source-dirs:   test
  default-language: GHC2024
  build-depends:
    base >=4.18 && <5,
    harpie >=0.1 && <1,
    mnet
